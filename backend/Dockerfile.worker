# ==============================================================================
# RoadTrace AI Worker - Multi-stage GPU Inference Dockerfile
# Base: NVIDIA CUDA 12.1.1 Runtime on Ubuntu 22.04
# Supports: PyTorch (CUDA), Ultralytics (YOLOv8), EasyOCR, ByteTrack
# Weights mounted via volume at /app/weights
# ==============================================================================

# Stage 1: Build virtual environment with CUDA-enabled PyTorch & ML dependencies
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip wheel && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu121 && \
    pip install --no-cache-dir -r requirements.txt


# Stage 2: Minimal CUDA runtime execution container
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Install runtime shared libraries for OpenCV, PostgreSQL client, and healthcheck utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgomp1 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-compiled virtualenv from builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# NVIDIA Container Runtime configuration
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Create non-root roadtrace user
RUN groupadd -g 1000 roadtrace && \
    useradd -u 1000 -g roadtrace -m -s /bin/bash roadtrace

# Create mount points for external weights and job snapshots
RUN mkdir -p /app/weights /app/snapshots && \
    chown -R roadtrace:roadtrace /app/weights /app/snapshots

# Mountable volume targets
VOLUME ["/app/weights", "/app/snapshots"]

# Copy application source code
COPY --chown=roadtrace:roadtrace . /app/

USER roadtrace

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python3 -c "import torch; print(f'CUDA available: {torch.cuda.is_available()}')" || exit 1

CMD ["python3", "-m", "app.workers.inference_worker"]
