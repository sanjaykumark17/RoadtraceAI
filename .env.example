# ==============================================================================
# RoadTrace AI - Environment Configuration Template
# ==============================================================================

# Database Settings (PostgreSQL + PostGIS on AWS RDS or local Docker)
RT_DATABASE_URL=postgresql+asyncpg://roadtrace:roadtrace@postgres:5432/roadtrace
RT_DATABASE_URL_SYNC=postgresql+psycopg2://roadtrace:roadtrace@postgres:5432/roadtrace

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=roadtrace
POSTGRES_PASSWORD=roadtrace
POSTGRES_DB=roadtrace

# JWT & Authentication Secrets
RT_SECRET_KEY=change-me-in-production-64-character-random-hex-string

# Security & CORS (Restricted to production frontend origins)
RT_CORS_ORIGINS=http://localhost:5173,http://localhost:80,https://roadtrace.vercel.app,https://roadtrace.ai
RT_FRONTEND_URL=https://roadtrace.vercel.app

# Authentication Rate Limiting
RT_AUTH_RATE_LIMIT_PER_MINUTE=60
RT_AUTH_RATE_LIMIT_ENABLED=true

# Worker Inference Settings
RT_WORKER_CONCURRENCY=2
RT_SNAPSHOTS_DIR=snapshots
RT_YOLO_WEIGHTS=yolov8m.pt

# Frontend Environment Variables (Vite on Vercel)
VITE_API_URL=https://api.roadtrace.ai
VITE_WS_URL=wss://api.roadtrace.ai
